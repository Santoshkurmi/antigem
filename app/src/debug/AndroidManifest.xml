<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds (ai.antidev) have no sharedUserId: a shared user is tied to the signing key, so a debug APK signed with
     another machine's debug key could not be installed over one already on the phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:remove="android:sharedUserId" />

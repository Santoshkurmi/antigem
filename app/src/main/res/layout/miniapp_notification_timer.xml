<?xml version="1.0" encoding="utf-8"?>
<!-- Mini app notification with a timer: title, a big time the system ticks itself (or a big static value), text.
     Used inside DecoratedCustomViewStyle, so Android still draws the header and the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/miniapp_notif_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <Chronometer
        android:id="@+id/miniapp_notif_timer"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/miniapp_notif_value"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textSize="30sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/miniapp_notif_body"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: splash with the centered Prism mark on graphite (splash_colors.xml) -->
    <style name="Theme.Gemini" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_prism_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_wordmark</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_bars</item>
    </style>

    <!-- Facebook Messenger-style Floating Multitasking Window Theme -->
    <style name="Theme.AntiGem.FloatingTranslucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>